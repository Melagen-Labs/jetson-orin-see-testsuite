[Unit]
Description=CUDA particles deterministic SEE workload (Jetson Orin Nano)
After=multi-user.target

[Service]
Type=simple
# Matches the proven on-target deployment under the melagen home dir. For a
# system-wide install, copy the tree to /opt/see/cuda_particles and update the
# three paths + User below to taste.
User=melagen
WorkingDirectory=/home/melagen/cuda_particles
ExecStart=/home/melagen/cuda_particles/build/cuda_particles --config /home/melagen/cuda_particles/config/particles.json
# JetPack CUDA runtime (binary links libcudart from here).
Environment=PATH=/usr/local/cuda/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64
Restart=always
RestartSec=2
# Exit code 2 (corruption observed) still restarts, but is recorded in the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
