[Unit]
Description=CUDA particles deterministic SEE workload (Jetson Orin Nano)
After=multi-user.target
# Crashes are expected DATA during a beam run, so never stop restarting: disable
# systemd's start-rate limiter (default gives up after 5 restarts in 10 s).
StartLimitIntervalSec=0

[Service]
Type=simple
# Matches the proven on-target deployment under the melagen home dir. For a
# system-wide install, copy the tree to /opt/see/cuda_particles and update the
# three paths + User below to taste.
#
# ARMING: the unit is `enable`d (wired to boot) but only starts when the ARMED
# flag file exists. `touch ARMED` once to arm a campaign -- it persists across
# reboots, so every boot (incl. a crash/watchdog reboot) restarts the workload
# with no further action. `rm ARMED` once to disarm so ordinary power-ons don't
# run it. Restart=always covers process-level crashes while the board stays up.
ConditionPathExists=/home/melagen/see-testsuite/jetson/compute/cuda_particles/ARMED
User=melagen
WorkingDirectory=/home/melagen/see-testsuite/jetson/compute/cuda_particles
ExecStart=/home/melagen/see-testsuite/jetson/compute/cuda_particles/build/cuda_particles --config /home/melagen/see-testsuite/jetson/compute/cuda_particles/config/particles.json
# JetPack CUDA runtime (binary links libcudart from here).
Environment=PATH=/usr/local/cuda/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64
Restart=always
RestartSec=1
# Exit code 2 (corruption observed) still restarts, but is recorded in the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
