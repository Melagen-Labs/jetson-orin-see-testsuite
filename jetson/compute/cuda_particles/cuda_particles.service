[Unit]
Description=CUDA particles deterministic SEE workload (Jetson Orin Nano)
After=multi-user.target

[Service]
Type=simple
# Adjust WorkingDirectory / paths to the deployed location on the DUT.
WorkingDirectory=/opt/see/cuda_particles
ExecStart=/opt/see/cuda_particles/cuda_particles --config /opt/see/cuda_particles/config/particles.json
Restart=always
RestartSec=2
# Exit code 2 (corruption observed) still restarts, but is recorded in the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
