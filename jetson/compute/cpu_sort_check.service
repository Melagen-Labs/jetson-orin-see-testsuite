[Unit]
Description=Radtest CPU checksummed sort workload (channel 1b)
Documentation=file:///opt/radtest/docs/BUILD_PLAN.md
After=multi-user.target

[Service]
Type=simple
# Adjust the install path (/opt/radtest) and log path to match your deployment.
ExecStart=/usr/bin/python3 /opt/radtest/jetson/compute/cpu_sort_check.py \
    --logfile /var/log/radtest/compute/cpu_sort.log
# A crash flips the unit to "failed", which the arbiter's status pull detects.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
