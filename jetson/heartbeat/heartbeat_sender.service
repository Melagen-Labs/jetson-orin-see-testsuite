[Unit]
Description=Radtest DUT heartbeat sender (1 Hz UDP to arbiter, channel 3b)
Documentation=file:///home/melagen/see-testsuite/docs/BUILD_PLAN.md
After=network.target

[Service]
Type=simple
# --arbiter-ip is set per board at install by setup-board.sh (ARBITER_IP=...):
# the arbiter's address -- 192.168.1.10 on the beam-line Ethernet, or the arbiter
# laptop's Tailscale IP for remote testing. It is fleet-wide, not per-board.
ExecStart=/usr/bin/python3 /home/melagen/see-testsuite/jetson/heartbeat/heartbeat_sender.py \
    --arbiter-ip 192.168.1.10 --port 5555 --interval 1.0
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
