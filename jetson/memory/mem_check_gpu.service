[Unit]
Description=GPU DRAM SEE pattern tester (Jetson Orin Nano, channel 2b)
After=multi-user.target

[Service]
Type=simple
# Same script as channel 2a, run with the GPU config (target=gpu): mem_check.py
# allocates a CuPy buffer in GPU DRAM instead of a numpy buffer in system RAM.
# Runs from the git clone at ~/see-testsuite (fleet model, docs/DEPLOYMENT.md);
# mem_check.py resolves shared/event_log.py via ../../shared in that layout.
#
# CuPy lives in the user site (~/.local, see docs/DEPENDENCIES.md), so HOME must
# be set for python3 to find it. The cupy-cuda12x wheel bundles the CUDA runtime,
# so no /usr/local/cuda on PATH is needed at runtime (only the driver, libcuda,
# which is on the system path).
#
# ARMING: shares the SAME ARMED flag as the 2a (CPU) unit, so one `touch ARMED`
# before a campaign arms both memory tests; `rm ARMED` disarms both. Restart=always
# covers process-level crashes while the board stays up.
ConditionPathExists=/home/melagen/see-testsuite/jetson/memory/ARMED
User=melagen
WorkingDirectory=/home/melagen/see-testsuite/jetson/memory
ExecStart=/usr/bin/python3 /home/melagen/see-testsuite/jetson/memory/mem_check.py --config /home/melagen/see-testsuite/jetson/memory/config/mem_check_gpu.json
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/melagen
Restart=always
RestartSec=2
# Exit code 2 (upset observed) still restarts, but is recorded in the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
